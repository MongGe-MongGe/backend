# =========================================================
# Project help
# =========================================================
HELP.md


# =========================================================
# Maven / Build output
# =========================================================
target/
*.class

# src 안에 있는 target 폴더는 예외 처리
# Spring Initializr 기본 설정 유지용
!**/src/main/**/target/
!**/src/test/**/target/


# =========================================================
# Maven Wrapper
# =========================================================
# Maven Wrapper는 팀원들이 Maven 설치 여부와 상관없이 같은 방식으로 빌드할 수 있게 해준다.
# 보통 mvnw, mvnw.cmd, .mvn/wrapper/maven-wrapper.properties는 Git에 올린다.
# jar 파일은 기본 템플릿에서 제외되어 있으므로 그대로 제외.
.mvn/wrapper/maven-wrapper.jar


# =========================================================
# Spring Boot local config
# =========================================================
# 개인 로컬 설정 파일
# DB 계정, 비밀번호, API Key 등이 들어가므로 Git에 올리지 않는다.
src/main/resources/application-local.properties
src/main/resources/application-local.yml

# 비밀 설정 파일을 따로 만들 경우
src/main/resources/application-secret.properties
src/main/resources/application-secret.yml

# 환경별 개인 설정 파일
src/main/resources/application-dev-local.properties
src/main/resources/application-prod-local.properties


# =========================================================
# Logs
# =========================================================
*.log
logs/


# =========================================================
# Uploaded files / Local storage
# =========================================================
# 파일 업로드 기능에서 로컬에 저장되는 파일들
uploads/
files/
storage/


# =========================================================
# STS / Eclipse
# =========================================================
.apt_generated/
.apt_generated_tests/
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache/
.metadata/
.recommenders/


# =========================================================
# IntelliJ IDEA
# =========================================================
.idea/
*.iws
*.iml
*.ipr


