<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.gourming.model.mapper.ImageMapper">

    <!-- 1. 이미지 신규 등록 (PENDING 상태) -->
    <insert id="insertImage" parameterType="ImageDto" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO images (filename, url, status, created_at)
        VALUES (#{filename}, #{url}, #{status}, NOW())
    </insert>

    <!-- 2. 여러 이미지의 상태를 한 번에 CONFIRMED로 변경 -->
    <update id="updateStatusToConfirmed" parameterType="list">
        UPDATE images
        SET status = 'CONFIRMED'
        WHERE url IN
        <foreach collection="list" item="url" open="(" separator="," close=")">
            #{url}
        </foreach>
    </update>

    <!-- 3. 여러 이미지의 상태를 다시 PENDING으로 변경 (스케줄러 삭제 유도) -->
    <update id="updateStatusToPending" parameterType="list">
        UPDATE images
        SET status = 'PENDING'
        WHERE url IN
        <foreach collection="list" item="url" open="(" separator="," close=")">
            #{url}
        </foreach>
    </update>

    <!-- 4. 스케줄러: 특정 시간 이전에 업로드된 PENDING 이미지 조회 -->
    <select id="findPendingImagesOlderThan" resultType="ImageDto">
        SELECT id, filename, url, status, created_at
        FROM images
        WHERE status = 'PENDING' 
          AND created_at &lt; #{time}
    </select>

    <!-- 5. 파일 삭제 후 DB 레코드 정리 (ID 기반) -->
    <delete id="deleteImageById" parameterType="long">
        DELETE FROM images WHERE id = #{id}
    </delete>

    <!-- 6. 단일 이미지 즉시 삭제 (URL 기반) -->
    <delete id="deleteImageByUrl" parameterType="string">
        DELETE FROM images WHERE url = #{url}
    </delete>

    <!-- 7. 다중 이미지 즉시 삭제 (URL 리스트 기반) -->
    <delete id="deleteImagesByUrls" parameterType="list">
        DELETE FROM images
        WHERE url IN
        <foreach collection="list" item="url" open="(" separator="," close=")">
            #{url}
        </foreach>
    </delete>

</mapper>
