<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.gourming.model.mapper.TasteTagMapper">

	<resultMap id="tasteTagResultMap"
		type="com.ssafy.gourming.model.dto.TasteTagDto$TasteTag">
		<id property="id" column="id" />
		<result property="code" column="code" />
		<result property="name" column="name" />
		<result property="type" column="type" />
		<result property="description" column="description" />
		<result property="active" column="active" />
		<result property="createdAt" column="created_at" />
		<result property="updatedAt" column="updated_at" />
	</resultMap>

	<!-- Fake/LLM 분석기에 전달할 허용 태그 목록이다. -->
	<select id="selectActiveTags" resultMap="tasteTagResultMap">
		SELECT
			id,
			code,
			name,
			type,
			description,
			active,
			created_at,
			updated_at
		FROM taste_tags
		WHERE active = TRUE
		ORDER BY type ASC, code ASC
	</select>

	<!-- 분석 결과의 tag code를 tag id로 변환할 때 사용한다. -->
	<select id="selectTagsByCodes" resultMap="tasteTagResultMap">
		SELECT
			id,
			code,
			name,
			type,
			description,
			active,
			created_at,
			updated_at
		FROM taste_tags
		WHERE code IN
		<foreach collection="codes" item="code" open="(" separator="," close=")">
			#{code}
		</foreach>
		ORDER BY type ASC, code ASC
	</select>

</mapper>
