<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ssafy.gourming.model.dao.UserMapper">

    <!-- type-aliases-package는 최상위 클래스만 스캔하므로,
         내부 정적 클래스(UserDto$SignupRequest 등)는 FQCN(전체 경로)으로 명시해야 합니다. -->

    <insert id="insertUser"
            parameterType="com.ssafy.gourming.model.dto.UserDto$SignupRequest">
        INSERT INTO users (email, password, handle, nickname, phone)
        VALUES (
            #{email},
            #{password},
            #{handle},
            #{nickname},
            #{phone}
        )
    </insert>

    <select id="findByEmail"
            parameterType="String"
            resultType="com.ssafy.gourming.model.dto.UserDto$UserEntity">
        SELECT id, email, password, nickname, handle, profile_image, phone
        FROM users
        WHERE email = #{email}
    </select>

    <select id="findByHandle"
            parameterType="String"
            resultType="com.ssafy.gourming.model.dto.UserDto$UserEntity">
        SELECT id, nickname, handle, profile_image, bio
        FROM users
        WHERE handle = #{handle}
    </select>

</mapper>
